        },
        {
          "answerId": "home.orchard",
          "text": "The windbreak and young trees behind the houses."
        }
      ],
      "promptId": "home",
      "promptText": "When the river rose, what part of home did you protect first?"
    },
    {
      "answers": [
        {
          "answerId": "rupture.shortage",
          "text": "A week when every household counted grain twice."
        },
        {
          "answerId": "rupture.flood",
          "text": "A night crossing when the marked path vanished under water."
        },
        {
          "answerId": "rupture.quarrel",
          "text": "A dispute that left two families unwilling to share tools."
        }
      ],
      "promptId": "rupture",
      "promptText": "What changed the way you prepare for a bad day?"
    },
    {
      "answers": [
        {
          "answerId": "work.pathfinder",
          "text": "Checking paths, tracks, and safe crossings before others travel."
        },
        {
          "answerId": "work.mender",
          "text": "Repairing baskets, gates, and small tools until they lasted another season."
        },
        {
          "answerId": "work.helper",
          "text": "Carrying messages and settling small misunderstandings between households."
        }
      ],
      "promptId": "work",
      "promptText": "Which ordinary work taught you to be useful?"
