{
  "name": "pokemon-ancient-trpg",
  "version": "0.0.0-p7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "test:browser:resources": "playwright test e2e/resource-cache.spec.ts",
    "test:browser:saves": "playwright test e2e/browser-save.spec.ts",
    "test:browser:p8-smoke": "playwright test e2e/p8-phone-flow.spec.ts --project=phone-chromium",
    "test:browser:p8-save": "playwright test e2e/p8-save-compat.spec.ts",
    "test:browser:p8-exit": "playwright test --config=playwright.p8-exit.config.ts",
    "test:browser:pwa": "playwright test --config=playwright.pwa.config.ts",
    "test:e2e": "npm run test:browser:resources && npm run test:browser:saves && npm run test:browser:pwa",
    "build": "npm run typecheck && vite build && node tools/build-service-worker.mjs && node tools/validate-dist.mjs && node tools/validate-static-deployment.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "preact": "10.29.7"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.10",
    "workbox-build": "7.4.1"
  }
}
