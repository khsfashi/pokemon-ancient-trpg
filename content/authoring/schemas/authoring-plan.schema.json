{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["topic_id", "title", "sessions"],
  "properties": {
    "topic_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_id", "title", "purpose", "target_chars", "target_paragraphs", "dependencies", "continuity_focus"],
        "properties": {
          "session_id": {"type": "string", "pattern": "^s[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "target_chars": {"type": "integer", "minimum": 500, "maximum": 8000},
          "target_paragraphs": {"type": "integer", "minimum": 2, "maximum": 40},
          "dependencies": {"type": "array", "items": {"type": "string", "pattern": "^s[0-9]{3}$"}, "uniqueItems": true},
          "continuity_focus": {"type": "array", "items": {"type": "string"}, "maxItems": 12}
        }
      }
    }
  }
}
